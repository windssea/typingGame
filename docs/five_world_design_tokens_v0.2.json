        "large metal corner plates",
        "warm timber or enameled surface",
        "embossed original insignia",
        "thick pressable buttons",
        "clear resource ornaments"
      ],
      "motion": [
        "firm anticipations",
        "cartoon recoil and bounce",
        "readable impact bursts",
        "brief medal-like reward spin"
      ],
      "vfx": [
        "bold fireball shapes",
        "simple arc lightning",
        "clean impact stars",
        "limited dust puffs"
      ],
      "benchmark": {
        "character_heavy": "原创王国重甲守卫",
        "character_ranged": "原创王国巡林弩手",
        "environment": "王国训练庭院与守门塔",
        "building": "厚石防御瞭望塔",
        "prop_functional": "攻城工具箱",
        "prop_reward": "王国战利品匣",
        "ui": "王国角色详情页、主操作面板、奖励弹窗",
        "vfx_normal": "盾牌格挡",
        "vfx_signature": "战旗冲击波"
      },
      "avoid": [
        "realistic medieval dirt and weathering",
        "fragile weapons and thin limbs",
        "dense heraldic microdetails",
        "copying actual Clash Royale towers, insignia or card frames",
        "making this kit identical to the magical fairytale kit"
      ],
      "contrast_with_fairytale": {
        "royal": "martial, architectural, heraldic, high physical weight",
        "fairytale": "organic, whimsical, botanical, magical, soft motion"
