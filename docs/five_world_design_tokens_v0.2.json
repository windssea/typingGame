{
  "metadata": {
    "name": "Multi-world Heroic Cartoon Design System",
    "version": "0.2.0",
    "status": "proposal-for-art-tests",
    "units": "logical dp for interface tokens, not texture pixels",
    "reference": "Original design system derived from broad stylized-cartoon art principles; not an official Clash Royale asset specification",
    "description_zh": "五世界独立型母设计系统，增加皇家奇幻战争Theme Kit并与童话世界区分。色值和参数仅作为提案基线。",
    "design_reference": "Clash Royale is used only as an analytic visual reference. This is not a Supercell standard or a license to copy specific game assets."
  },
  "governance": {
    "cascade": [
      "core",
      "theme",
      "gameplay",
      "component",
      "screen"
    ],
    "protected": [
      "semantic.meaning",
      "shape.principles",
      "material.detail_policy",
      "ui.state_meaning",
      "accessibility.minimum_target_dp"
    ],
    "exception_requires": [
      "visual-lead-review",
      "usability-test",
      "recorded-rationale"
    ]
  },
  "core": {
    "shape": {
      "dominant_secondary_micro_heuristic": [
        0.65,
        0.25,
        0.1
      ],
      "character_primary_forms": "one dominant mass, two to four readable secondary masses",
      "principles": [
        "chunky masses",
        "rounded or chamfered edges",
        "exaggerated focal features",
        "clear silhouettes",
        "restricted microdetails"
      ],
      "silhouette_review_sizes_px": [
        48,
        96,
        192
      ]
    },
    "material": {
      "detail_policy": "large color regions first; medium features second; no photographic micro-noise",
      "highlight": "broad, designed, material-specific",
      "surface_families": [
        "skin",
        "paint",
        "metal",
        "wood",
        "stone",
        "cloth",
        "glass",
        "energy"
      ]
    },
    "lighting": {
      "principles": [
        "single coherent key direction per scene",
        "soft readable fills",
        "contact for grounding",
        "protect gameplay contrast"
      ],
      "hero_render_can_use_extra_rim_light": true
    },
    "semantic": {
      "colors": {
        "ally": "#3976C9",
        "enemy": "#D34F50",
        "positive": "#3F9C65",
        "warning": "#D59A2B",
        "danger": "#D44846",
        "special": "#9564D8",
        "disabled": "#7F8B98",
        "ink_on_light": "#243044",
        "ink_on_dark": "#FFFFFF",
        "neutral_surface_light": "#F2E6CF",
        "neutral_surface_dark": "#273950"
      },
      "note": "Example defaults only. Verify contrast, color-vision redundancy and gameplay semantics on actual screens."
    },
    "ui": {
      "spacing_dp": {
        "2xs": 4,
        "xs": 8,
        "sm": 12,
        "md": 16,
        "lg": 24,
        "xl": 32,
        "2xl": 48,
        "3xl": 64
      },
      "radius_dp": {
        "sm": 8,
        "md": 12,
        "lg": 18,
        "xl": 24,
        "pill": 999
      },
      "border_dp": {
        "thin": 2,
        "standard": 3,
        "hero": 4
      },
      "raised_depth_dp": {
        "sm": 3,
        "md": 5,
        "lg": 8
      },
      "type_dp": {
        "caption": 12,
        "body_sm": 14,
        "body": 16,
        "subtitle": 20,
        "title": 24,
        "hero": 32
      },
      "hit_target_min_dp": 48,
      "motion_ms": {
        "press_in": 100,
        "release": 160,
        "panel_enter": 260,
        "reward_reveal": 560
      },
      "buttons": {
        "min_height_dp": 48,
        "recommended_height_dp": 56,
        "states": [
          "default",
          "pressed",
          "focused",
          "selected",
          "disabled",
          "loading"
        ]
      },
      "text_rules": [
        "numeric data use tabular figures when possible",
        "text remains readable at target scale",
        "no color-only encoding",
        "verify localization expansion"
      ]
    }
  },
  "themes": {
    "royal_fantasy": {
      "name_zh": "皇家奇幻战争",
      "name_en": "Royal Fantasy Warfare",
      "identity": "Humorous, sturdy, heroic miniature kingdom warfare; original royal insignia and architecture, not a replica of Clash Royale.",
      "palette": {
        "primary": "#4365A0",
        "secondary": "#D7A857",
        "accent": "#C76958",
        "surface": "#5D6575",
        "neutral": "#CEC5AF"
      },
      "support_palette": {
        "stone": "#A4A59B",
        "timber": "#956F4D",
        "metal": "#8C99AA",
        "cloth": "#D5C4A5",
        "vegetation": "#83AD70",
        "ink": "#26364E"
      },
      "dominant_forms": [
        "broad rounded rectangles",
        "large blocky body masses",
        "oversized shields and weapons",
        "thick crenellated tower volumes",
        "compact low-center-of-gravity silhouettes"
      ],
      "character_dna": {
        "archetypes": [
          "sturdy royal guard",
          "nimble ranger",
          "eccentric alchemist",
          "heavy siege engineer",
          "friendly monster companion"
        ],
        "faces": [
          "expressive heavy eyebrows",
          "graphic noses and moustaches",
          "simple readable mouths",
          "large facial planes"
        ],
        "equipment": [
          "large segmented pauldrons",
          "thick tower shield",
          "oversized mallet or crossbow",
          "banner-shaped soft goods"
        ],
        "do_not_copy": [
          "recognizable official troop characters",
          "existing royal crown emblem",
          "distinctive existing costume silhouettes",
          "official troop portraits"
        ]
      },
      "environment_dna": {
        "architecture": [
          "low wide stone bastion",
          "round-edged gatehouse",
          "stacked defensive turret",
          "simple visible bridges",
          "wood-and-stone courtyard"
        ],
        "layout": [
          "clean functional playfield",
          "legible route and chokepoint silhouettes",
          "perimeter story dressing"
        ],
        "camera": "gameplay-dependent, not tied to Clash Royale two-lane arena"
      },
      "materials": [
        "soft faceted stone blocks",
        "broad-highlight warm metal",
        "clean chunky timber",
        "painted enamel",
        "thick woven banners"
      ],
      "motifs": [
        "original heraldic geometric crest",
        "broad battlement outline",
        "banner tail",
        "simple shield silhouette"
      ],
      "ui_skin": [
