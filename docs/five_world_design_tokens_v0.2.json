  "components": {
    "button_primary": {
      "inherits": [
        "core.ui",
        "theme.ui_skin"
      ],
      "height_dp": 56,
      "radius_ref": "core.ui.radius.lg",
      "raised_depth_ref": "core.ui.raised_depth.md",
      "interactive_states": [
        "default",
        "pressed",
        "focused",
        "disabled",
        "loading"
      ],
      "must_keep": [
        "high hierarchy",
        "visible press feedback",
        "sufficient text contrast"
      ]
    },
    "card_entity": {
      "inherits": [
        "core.ui",
        "theme.ui_skin"
      ],
      "radius_ref": "core.ui.radius.md",
      "border_ref": "core.ui.border.standard",
      "must_keep": [
        "large subject silhouette",
        "clear name and status",
        "consistent hierarchy"
      ]
    },
    "panel_modal": {
      "inherits": [
        "core.ui",
        "theme.ui_skin"
      ],
      "radius_ref": "core.ui.radius.xl",
      "must_keep": [
        "single primary action",
        "clear safe close",
        "readable background"
      ]
    },
    "icon_reward": {
      "inherits": [
        "core.shape",
        "theme.motifs"
      ],
      "must_keep": [
        "large unified mass",
        "meaning visible at small size",
        "restricted microdetails"
      ]
    }
  },
  "validation": {
    "rubric_scale": {
      "1": "does not meet",
      "2": "major revision",
      "3": "acceptable with fixes",
      "4": "meets",
      "5": "strong benchmark"
    },
    "weights": {
      "silhouette_and_mass": 20,
      "material_and_light": 15,
      "color_hierarchy": 15,
      "world_kit_identity": 15,
      "ui_consistency": 15,
      "readability": 20
    },
    "proposed_pass_total": 85,
    "critical_gates": [
      "gameplay readability",
      "interaction ambiguity",
      "unreadable text",
      "inconsistent core shape language"
    ],
    "note": "Scoring and thresholds are suggested starting points. Lock after two review rounds.",
    "world_count": 5,
    "minimum_style_benchmark_quantities": {
      "characters": 10,
      "environments": 5,
      "buildings_and_props": 15,
      "ui_skin_sets": 5,
      "vfx_samples": 10
    },
    "crossworld_theme_test": "Use identical functional briefs for each world, but different original themed assets. Test mother-style coherence and world differences independently."
  },
  "world_order": [
    "royal_fantasy",
    "sci_fi",
    "modern",
    "ancient",
    "fairytale"
  ]
}
